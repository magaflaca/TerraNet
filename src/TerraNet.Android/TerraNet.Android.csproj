<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <ApplicationId>win.hacks.terranet</ApplicationId>
    <ApplicationTitle>TerraNet</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <AndroidStoreUncompressedFileExtensions>.zip</AndroidStoreUncompressedFileExtensions>
    <ServerPackDir>$(MSBuildThisFileDirectory)..\..\artifacts\server\android-arm64</ServerPackDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TerraNet.App\TerraNet.App.csproj" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(ServerPackDir)\pack.json')">
    <AndroidNativeLibrary Include="$(ServerPackDir)\libtnhost.so" Abi="arm64-v8a" />
  </ItemGroup>
  <Target Name="PackServer" BeforeTargets="_ComputeAndroidAssetsPaths;UpdateAndroidAssets;_GenerateAndroidAssetsDir" Condition="Exists('$(ServerPackDir)\pack.json')">
    <PropertyGroup>
      <ServerPackStage>$(IntermediateOutputPath)serverpack</ServerPackStage>
      <ServerPackZip>$(IntermediateOutputPath)server.zip</ServerPackZip>
    </PropertyGroup>
    <ItemGroup>
      <ServerPackFile Include="$(ServerPackDir)\**" Exclude="$(ServerPackDir)\libtnhost.so" />
    </ItemGroup>
    <RemoveDir Directories="$(ServerPackStage)" />
    <Copy SourceFiles="@(ServerPackFile)" DestinationFiles="@(ServerPackFile->'$(ServerPackStage)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <ZipDirectory SourceDirectory="$(ServerPackStage)" DestinationFile="$(ServerPackZip)" Overwrite="true" />
    <ItemGroup>
      <AndroidAsset Include="$(ServerPackZip)" LogicalName="server.zip" />
    </ItemGroup>
  </Target>
</Project>
