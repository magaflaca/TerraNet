<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:TerraNet.App.Controls">

  <FontFamily x:Key="ContentControlThemeFontFamily">avares://TerraNet.App/Assets/Fonts#Pixelify Sans</FontFamily>
  <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
  <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
  <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
  <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
  <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
  <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
  <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
  <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>

  <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <c:PixelFrame Name="Frame"
                      Fill="{TemplateBinding Background}"
                      Stroke="{DynamicResource OutlineBrush}"
                      Shadow="{DynamicResource ShadowBrush}"
                      Highlight="{DynamicResource HighlightBrush}"
                      Padding="{TemplateBinding Padding}">
          <ContentPresenter Name="Content"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </c:PixelFrame>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pressed /template/ c|PixelFrame#Frame">
      <Setter Property="Sunk" Value="True" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="^.primary">
      <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
    </Style>
    <Style Selector="^.danger">
      <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
    </Style>
    <Style Selector="^.soft">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    </Style>
    <Style Selector="^.icon">
      <Setter Property="Padding" Value="9" />
    </Style>
    <Style Selector="^.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="Content"
                            Background="Transparent"
                            Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" />
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="^.ghost:pressed /template/ ContentPresenter#Content">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="ChoiceItem" TargetType="ListBoxItem">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="Padding" Value="8,10" />
    <Setter Property="Margin" Value="4" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <c:PixelFrame Name="Frame"
                      Fill="{TemplateBinding Background}"
                      Stroke="{DynamicResource OutlineBrush}"
                      Shadow="{DynamicResource ShadowBrush}"
                      Highlight="{DynamicResource HighlightBrush}"
                      Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="Center" />
        </c:PixelFrame>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:selected">
      <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
    </Style>
    <Style Selector="^:selected /template/ c|PixelFrame#Frame">
      <Setter Property="Stroke" Value="{DynamicResource PrimaryBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ c|PixelFrame#Frame">
      <Setter Property="Sunk" Value="True" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="ChoiceList" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource ChoiceItem}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    <Setter Property="Template">
      <ControlTemplate>
        <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
      </ControlTemplate>
    </Setter>
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <UniformGrid Rows="1" />
      </ItemsPanelTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
