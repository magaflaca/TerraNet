<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TerraNet.App.ViewModels"
             xmlns:v="using:TerraNet.App.Views"
             xmlns:c="using:TerraNet.App.Controls"
             xmlns:app="using:TerraNet.App"
             x:Class="TerraNet.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">
  <Grid Name="Root" RowDefinitions="Auto,*">
    <Panel Name="Hero" Height="230">
      <c:SkyScene Mood="{Binding Session.Mood}"
                  SkyTop="{DynamicResource SkyTopColor}"
                  SkyBottom="{DynamicResource SkyBottomColor}" />
      <Grid Margin="{DynamicResource SafeAreaTop}" ColumnDefinitions="*,Auto" VerticalAlignment="Top">
        <c:PixelTitle Name="Title" Margin="18,18,0,0" FontSize="38" HorizontalAlignment="Left" />
        <Button Grid.Column="1"
                Classes="soft icon"
                VerticalAlignment="Top"
                Margin="0,22,16,0"
                Command="{Binding $parent[v:MainView].((vm:MainViewModel)DataContext).OpenSettingsCommand}">
          <c:PixelSprite Sprite="gear" Unit="2" />
        </Button>
      </Grid>
    </Panel>

    <ScrollViewer Name="Body" Grid.Row="1">
      <StackPanel Name="Stack" MaxWidth="560" Margin="16,18,16,28" Spacing="18">

        <c:PixelFrame Classes="card" IsVisible="{Binding !IsIdle}">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <c:PixelSprite Sprite="world" Unit="3" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Classes="h2" Text="{Binding Session.WorldName}" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <c:PixelSprite Sprite="heart" Unit="2" IsVisible="{Binding Session.IsRunning}" />
                  <TextBlock Classes="muted" Text="{Binding Session.Status}" />
                </StackPanel>
              </StackPanel>
              <Button Grid.Column="2" Classes="soft icon" VerticalAlignment="Center" Command="{Binding OpenConsoleCommand}">
                <c:PixelSprite Sprite="console" Unit="2" />
              </Button>
            </Grid>

            <c:PixelProgress IsVisible="{Binding Session.ShowProgress}"
                             Value="{Binding Session.Progress}"
                             IsIndeterminate="{Binding Session.IsIndeterminate}" />

            <StackPanel Spacing="6" IsVisible="{Binding Session.HasAddress}">
              <TextBlock Classes="label" Text="{app:Tr address}" />
              <c:PixelFrame Classes="field" Padding="12,10">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <SelectableTextBlock Classes="address"
                                       Text="{Binding Session.Address}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource InkBrush}"
                                       VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="soft icon" Margin="8,0,0,0" Command="{Binding CopyCommand}">
                    <c:PixelSprite Sprite="copy" Unit="2" />
                  </Button>
                  <Button Grid.Column="2" Classes="primary icon" Margin="8,0,0,0" Command="{Binding ShareCommand}">
                    <c:PixelSprite Sprite="share" Unit="2" />
                  </Button>
                </Grid>
              </c:PixelFrame>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding Session.IsConnecting}">
              <c:PixelSprite Sprite="signal" Unit="2" Tint="{DynamicResource InkMutedBrush}" />
              <TextBlock Classes="muted" Text="{app:Tr connecting}" />
            </StackPanel>

            <StackPanel Spacing="8" IsVisible="{Binding Session.IsRunning}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="label" Text="{app:Tr players}" />
                <TextBlock Grid.Column="1" Classes="label" Text="{Binding Session.PlayersText}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Session.Players}" IsVisible="{Binding Session.HasPlayers}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <c:PixelFrame Classes="chip" Margin="0,0,6,6">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <c:PixelSprite Sprite="person" Unit="1" />
                        <TextBlock Text="{Binding}" FontSize="14" />
                      </StackPanel>
                    </c:PixelFrame>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="muted" Text="{app:Tr nobody}" IsVisible="{Binding !Session.HasPlayers}" />
            </StackPanel>

            <Button Classes="danger" HorizontalAlignment="Stretch" Command="{Binding StopCommand}" IsEnabled="{Binding !Session.IsCrashed}">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <c:PixelSprite Sprite="stop" Unit="2" />
                <TextBlock Text="{app:Tr stop}" Foreground="{DynamicResource OnPrimaryBrush}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </c:PixelFrame>

        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="h1" Text="{app:Tr worlds}" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="primary icon" Command="{Binding NewWorldCommand}">
            <c:PixelSprite Sprite="plus" Unit="2" />
          </Button>
        </Grid>

        <c:PixelFrame Classes="card" IsVisible="{Binding IsEmpty}" Padding="16,26">
          <StackPanel Spacing="18" HorizontalAlignment="Center">
            <c:PixelSprite Sprite="slimeGreen" Unit="5" />
            <Button Classes="primary" Command="{Binding NewWorldCommand}">
              <TextBlock Text="{app:Tr firstWorld}" Foreground="{DynamicResource OnPrimaryBrush}" />
            </Button>
          </StackPanel>
        </c:PixelFrame>

        <ItemsControl ItemsSource="{Binding Worlds}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:WorldItemViewModel">
              <c:PixelFrame Classes="card" Margin="0,0,0,12" Padding="14,12">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <c:PixelSprite Sprite="world" Unit="3" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center" Spacing="6">
                    <TextBlock Classes="h2" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <c:PixelFrame Classes="chip">
                        <TextBlock Text="{Binding SizeLabel}" FontSize="13" />
                      </c:PixelFrame>
                      <c:PixelFrame Classes="chip">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <c:PixelSprite Sprite="{Binding DifficultySprite}" Unit="1" />
                          <TextBlock Text="{Binding DifficultyLabel}" FontSize="13" />
                        </StackPanel>
                      </c:PixelFrame>
                      <c:PixelFrame Classes="chip">
                        <c:PixelSprite Sprite="{Binding EvilSprite}" Unit="1" />
                      </c:PixelFrame>
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="ghost"
                            IsVisible="{Binding !IsLive}"
                            Command="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).DeleteCommand}"
                            CommandParameter="{Binding}">
                      <c:PixelSprite Sprite="trash" Unit="2" Tint="{DynamicResource InkMutedBrush}" />
                    </Button>
                    <Button Classes="primary"
                            Padding="12,8"
                            IsVisible="{Binding !IsLive}"
                            IsEnabled="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).IsIdle}"
                            Command="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).HostCommand}"
                            CommandParameter="{Binding}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:PixelSprite Sprite="play" Unit="2" />
                        <TextBlock Text="{app:Tr host}" Foreground="{DynamicResource OnPrimaryBrush}" />
                      </StackPanel>
                    </Button>
                    <c:PixelSprite Sprite="heart" Unit="3" IsVisible="{Binding IsLive}" />
                  </StackPanel>
                </Grid>
              </c:PixelFrame>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
