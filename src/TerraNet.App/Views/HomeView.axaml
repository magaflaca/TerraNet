<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TerraNet.App.ViewModels"
             xmlns:v="using:TerraNet.App.Views"
             xmlns:c="using:TerraNet.App.Controls"
             xmlns:app="using:TerraNet.App"
             x:Class="TerraNet.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">
  <Panel>
    <c:PixelTitle Classes="hero" />

    <c:PixelFrame Classes="sheet">
      <Grid RowDefinitions="Auto,*">
        <Grid Margin="14,12,12,6" ColumnDefinitions="Auto,*,Auto,Auto,Auto">
          <c:PixelSprite Sprite="world" Unit="2" VerticalAlignment="Center" Margin="0,0,10,0" />
          <TextBlock Grid.Column="1" Classes="h1" Text="{app:Tr worlds}" VerticalAlignment="Center" />
          <Button Grid.Column="2" Classes="soft icon" Margin="0,0,10,0"
                  Command="{Binding $parent[v:MainView].((vm:MainViewModel)DataContext).OpenSettingsCommand}">
            <c:PixelSprite Sprite="gear" Unit="2" />
          </Button>
          <Button Grid.Column="3" Classes="soft icon" Margin="0,0,10,0"
                  Command="{Binding $parent[v:MainView].((vm:MainViewModel)DataContext).ImportCommand}">
            <c:PixelSprite Sprite="download" Unit="2" />
          </Button>
          <Button Grid.Column="4" Classes="primary icon" Command="{Binding NewWorldCommand}">
            <c:PixelSprite Sprite="plus" Unit="2" />
          </Button>
        </Grid>

        <ScrollViewer Grid.Row="1">
          <StackPanel Margin="12,6,12,14" Spacing="14">

            <c:PixelFrame Classes="card" IsVisible="{Binding !IsIdle}" Fill="{DynamicResource SurfaceAltBrush}">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <c:PixelSprite Sprite="world" Unit="3" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="h2" Text="{Binding Session.WorldName}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <c:PixelSprite Sprite="heart" Unit="2" IsVisible="{Binding Session.IsRunning}" />
                      <TextBlock Classes="muted" Text="{Binding Session.Status}" />
                    </StackPanel>
                  </StackPanel>
                  <Button Grid.Column="2" Classes="soft icon" VerticalAlignment="Center" Command="{Binding OpenConsoleCommand}">
                    <c:PixelSprite Sprite="console" Unit="2" />
                  </Button>
                </Grid>

                <c:PixelProgress IsVisible="{Binding Session.ShowProgress}"
                                 Value="{Binding Session.Progress}"
                                 IsIndeterminate="{Binding Session.IsIndeterminate}" />

                <StackPanel Spacing="10" IsVisible="{Binding Session.HasAddress}">
                  <Grid ColumnDefinitions="*,10,Auto">
                    <StackPanel>
                      <TextBlock Classes="label" Text="{app:Tr ip}" />
                      <c:PixelFrame Classes="field" Padding="10,6">
                        <Grid ColumnDefinitions="*,Auto">
                          <SelectableTextBlock Text="{Binding Session.Host}" FontSize="19" FontWeight="Bold"
                                               Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          <Button Grid.Column="1" Classes="ghost" Command="{Binding CopyHostCommand}">
                            <c:PixelSprite Sprite="copy" Unit="2" />
                          </Button>
                        </Grid>
                      </c:PixelFrame>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Classes="label" Text="{app:Tr port}" />
                      <c:PixelFrame Classes="field" Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <SelectableTextBlock Text="{Binding Session.Port}" FontSize="19" FontWeight="Bold"
                                               Foreground="{DynamicResource GoldBrush}" VerticalAlignment="Center" />
                          <Button Classes="ghost" Command="{Binding CopyPortCommand}">
                            <c:PixelSprite Sprite="copy" Unit="2" />
                          </Button>
                        </StackPanel>
                      </c:PixelFrame>
                    </StackPanel>
                  </Grid>
                  <Button Classes="primary" HorizontalAlignment="Stretch" Command="{Binding ShareCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <c:PixelSprite Sprite="share" Unit="2" />
                      <TextBlock Text="{app:Tr share}" Foreground="{DynamicResource OnPrimaryBrush}" />
                    </StackPanel>
                  </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding Session.IsConnecting}">
                  <c:PixelSprite Sprite="signal" Unit="2" Tint="{DynamicResource InkMutedBrush}" />
                  <TextBlock Classes="muted" Text="{app:Tr connecting}" />
                </StackPanel>

                <StackPanel Spacing="8" IsVisible="{Binding Session.IsRunning}">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <c:PixelSprite Sprite="person" Unit="2" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Classes="label" Margin="0" VerticalAlignment="Center" Text="{app:Tr players}" />
                    <TextBlock Grid.Column="2" Classes="label" Margin="0" VerticalAlignment="Center" Text="{Binding Session.PlayersText}" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Session.Players}" IsVisible="{Binding Session.HasPlayers}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <c:PixelFrame Classes="chip" Margin="0,0,6,6">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:PixelSprite Sprite="heart" Unit="1" />
                            <TextBlock Text="{Binding}" FontSize="14" />
                          </StackPanel>
                        </c:PixelFrame>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !Session.HasPlayers}">
                    <c:PixelSprite Sprite="heartEmpty" Unit="1" />
                    <TextBlock Classes="muted" Text="{app:Tr nobody}" />
                  </StackPanel>
                </StackPanel>

                <Button Classes="danger" HorizontalAlignment="Stretch" Command="{Binding StopCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <c:PixelSprite Sprite="stop" Unit="2" />
                    <TextBlock Text="{app:Tr stop}" Foreground="{DynamicResource OnPrimaryBrush}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </c:PixelFrame>

            <c:PixelFrame Classes="card" IsVisible="{Binding IsEmpty}" Fill="{DynamicResource AccentSoftBrush}" Padding="16,22">
              <StackPanel Spacing="16" HorizontalAlignment="Center">
                <Grid ColumnDefinitions="Auto,Auto,Auto" HorizontalAlignment="Center">
                  <c:PixelSprite Sprite="sparkle" Unit="2" VerticalAlignment="Top" />
                  <c:PixelSprite Grid.Column="1" Sprite="world" Unit="5" Margin="10,0" />
                  <c:PixelSprite Grid.Column="2" Sprite="sparkle" Unit="3" VerticalAlignment="Bottom" />
                </Grid>
                <Button Classes="primary" Command="{Binding NewWorldCommand}" HorizontalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <c:PixelSprite Sprite="plus" Unit="2" />
                    <TextBlock Text="{app:Tr firstWorld}" Foreground="{DynamicResource OnPrimaryBrush}" />
                  </StackPanel>
                </Button>
                <Button Classes="soft" HorizontalAlignment="Center"
                        Command="{Binding $parent[v:MainView].((vm:MainViewModel)DataContext).ImportCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <c:PixelSprite Sprite="download" Unit="2" />
                    <TextBlock Text="{app:Tr import}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </c:PixelFrame>

            <ItemsControl ItemsSource="{Binding Worlds}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WorldItemViewModel">
                  <c:PixelFrame Classes="card" Margin="0,0,0,10" Padding="12,10">
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                      <c:PixelSprite Grid.RowSpan="2" Sprite="world" Unit="3" VerticalAlignment="Top" Margin="0,2,12,0" />
                      <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Classes="h2" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <WrapPanel>
                          <c:PixelFrame Classes="chip" Margin="0,0,6,6">
                            <TextBlock Text="{Binding SizeLabel}" FontSize="13" />
                          </c:PixelFrame>
                          <c:PixelFrame Classes="chip" Margin="0,0,6,6">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                              <c:PixelSprite Sprite="{Binding DifficultySprite}" Unit="1" />
                              <TextBlock Text="{Binding DifficultyLabel}" FontSize="13" />
                            </StackPanel>
                          </c:PixelFrame>
                          <c:PixelFrame Classes="chip" Margin="0,0,6,6">
                            <c:PixelSprite Sprite="{Binding EvilSprite}" Unit="1" />
                          </c:PixelFrame>
                        </WrapPanel>
                      </StackPanel>
                      <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Classes="ghost"
                                IsVisible="{Binding !IsLive}"
                                Command="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).DeleteCommand}"
                                CommandParameter="{Binding}">
                          <c:PixelSprite Sprite="trash" Unit="2" Tint="{DynamicResource InkMutedBrush}" />
                        </Button>
                        <Button Classes="primary"
                                Padding="14,8"
                                IsVisible="{Binding !IsLive}"
                                IsEnabled="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).IsIdle}"
                                Command="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).HostCommand}"
                                CommandParameter="{Binding}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <c:PixelSprite Sprite="play" Unit="2" />
                            <TextBlock Text="{app:Tr host}" Foreground="{DynamicResource OnPrimaryBrush}" />
                          </StackPanel>
                        </Button>
                        <c:PixelSprite Sprite="heart" Unit="3" IsVisible="{Binding IsLive}" Margin="0,4,6,4" />
                      </StackPanel>
                    </Grid>
                  </c:PixelFrame>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </c:PixelFrame>
  </Panel>
</UserControl>
