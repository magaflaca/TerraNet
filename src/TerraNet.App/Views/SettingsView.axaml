<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TerraNet.App.ViewModels"
             xmlns:v="using:TerraNet.App.Views"
             xmlns:c="using:TerraNet.App.Controls"
             xmlns:app="using:TerraNet.App"
             x:Class="TerraNet.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <UserControl.Styles>
    <Style Selector="Grid.row">
      <Setter Property="MinHeight" Value="44" />
    </Style>
    <Style Selector="Grid.row > TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <c:PixelFrame Classes="sheet">
  <Grid RowDefinitions="Auto,*">
    <v:PageHeader Title="{app:Tr settings}" />

    <ScrollViewer Grid.Row="1">
      <StackPanel MaxWidth="560" Margin="16,8,16,28" Spacing="18">
        <c:PixelFrame Classes="card">
          <StackPanel Spacing="14">
            <Grid Classes="row" ColumnDefinitions="Auto,*,Auto">
              <c:PixelSprite Sprite="person" Unit="2" Margin="0,0,12,0" />
              <TextBlock Grid.Column="1" Text="{app:Tr maxPlayers}" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                <Button Classes="soft icon" Command="{Binding FewerPlayersCommand}">
                  <c:PixelSprite Sprite="minus" Unit="1" />
                </Button>
                <TextBlock Text="{Binding MaxPlayers}" FontSize="20" FontWeight="Bold" MinWidth="28" TextAlignment="Center" VerticalAlignment="Center" />
                <Button Classes="soft icon" Command="{Binding MorePlayersCommand}">
                  <c:PixelSprite Sprite="plus" Unit="1" />
                </Button>
              </StackPanel>
            </Grid>
            <StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                <c:PixelSprite Sprite="lock" Unit="2" />
                <TextBlock Text="{app:Tr password}" VerticalAlignment="Center" />
              </StackPanel>
              <c:PixelFrame Classes="field">
                <TextBox Text="{Binding Password}" PlaceholderText="{app:Tr none}" MaxLength="40" />
              </c:PixelFrame>
            </StackPanel>
          </StackPanel>
        </c:PixelFrame>

        <c:PixelFrame Classes="card">
          <StackPanel Spacing="10">
            <Grid Classes="row" ColumnDefinitions="*,Auto">
              <TextBlock Text="{app:Tr sounds}" />
              <c:PixelSwitch Grid.Column="1" IsChecked="{Binding Sounds}" />
            </Grid>
            <Grid Classes="row" ColumnDefinitions="*,Auto">
              <TextBlock Text="{app:Tr keepAwake}" />
              <c:PixelSwitch Grid.Column="1" IsChecked="{Binding KeepAwake}" />
            </Grid>
            <Grid Classes="row" ColumnDefinitions="*,Auto">
              <TextBlock Text="{app:Tr restartOnCrash}" />
              <c:PixelSwitch Grid.Column="1" IsChecked="{Binding RestartOnCrash}" />
            </Grid>
            <Grid Classes="row" ColumnDefinitions="*,Auto" IsVisible="{Binding SupportsStartOnBoot}">
              <TextBlock Text="{app:Tr startOnBoot}" />
              <c:PixelSwitch Grid.Column="1" IsChecked="{Binding StartOnBoot}" />
            </Grid>
          </StackPanel>
        </c:PixelFrame>

        <StackPanel>
          <TextBlock Classes="label" Text="{app:Tr theme}" />
          <ListBox Theme="{StaticResource ChoiceList}" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:Choice">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                  <c:PixelSprite Sprite="{Binding Sprite}" Unit="2" />
                  <TextBlock Text="{Binding Label}" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>

        <c:PixelFrame Classes="card">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <c:PixelSprite Sprite="slime" Unit="2" />
            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
              <TextBlock Text="TerraNet" FontWeight="Bold" />
              <TextBlock Classes="muted">
                <Run Text="{app:Tr version}" />
                <Run Text="{Binding Version}" />
              </TextBlock>
            </StackPanel>
            <Button Grid.Column="2" Classes="soft icon" Command="{Binding CheckUpdatesCommand}" IsEnabled="{Binding !IsChecking}">
              <c:PixelSprite Sprite="download" Unit="2" />
            </Button>
          </Grid>
        </c:PixelFrame>
      </StackPanel>
    </ScrollViewer>
  </Grid>
  </c:PixelFrame>
</UserControl>
