<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TerraNet.App.ViewModels"
             xmlns:v="using:TerraNet.App.Views"
             xmlns:c="using:TerraNet.App.Controls"
             xmlns:app="using:TerraNet.App"
             x:Class="TerraNet.App.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource PageBrush}"
             SizeChanged="OnSizeChanged"
             FontFamily="{StaticResource PixelFont}">
  <UserControl.Resources>
    <Thickness x:Key="SafeAreaTop">0</Thickness>
    <Thickness x:Key="SafeAreaBottom">0</Thickness>
    <Thickness x:Key="SheetMargin">24</Thickness>
    <HorizontalAlignment x:Key="SheetHorizontal">Right</HorizontalAlignment>
    <VerticalAlignment x:Key="SheetVertical">Center</VerticalAlignment>
    <x:Double x:Key="SheetWidth">560</x:Double>
    <x:Double x:Key="SheetMaxHeight">640</x:Double>
    <Thickness x:Key="TallSheetMargin">24</Thickness>
    <VerticalAlignment x:Key="TallSheetVertical">Center</VerticalAlignment>
    <x:Double x:Key="TallSheetMaxHeight">640</x:Double>
    <Thickness x:Key="TitleMargin">28</Thickness>
    <x:Double x:Key="TitleSize">48</x:Double>
  </UserControl.Resources>
  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:HomeViewModel"><v:HomeView /></DataTemplate>
    <DataTemplate DataType="vm:WorldEditorViewModel"><v:WorldEditorView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel"><v:SettingsView /></DataTemplate>
    <DataTemplate DataType="vm:ConsoleViewModel"><v:ConsoleView /></DataTemplate>
    <DataTemplate DataType="vm:UpdateViewModel"><v:UpdateView /></DataTemplate>
    <DataTemplate DataType="vm:ConfirmViewModel"><v:ConfirmView /></DataTemplate>
    <DataTemplate DataType="vm:PromptViewModel"><v:PromptView /></DataTemplate>
    <DataTemplate DataType="vm:BridgeViewModel"><v:BridgeView /></DataTemplate>
    <DataTemplate DataType="vm:ProxyViewModel"><v:ProxyView /></DataTemplate>
    <DataTemplate DataType="vm:ServerSettingsViewModel"><v:ServerSettingsView /></DataTemplate>
    <DataTemplate DataType="vm:TShockOptionsViewModel"><v:TShockOptionsView /></DataTemplate>
  </UserControl.DataTemplates>

  <Panel>
    <c:SkyScene Name="Scene" Mood="{Binding Home.Session.Mood}" />
    <TransitioningContentControl Content="{Binding Page}">
      <TransitioningContentControl.PageTransition>
        <CrossFade Duration="0:0:0.18" />
      </TransitioningContentControl.PageTransition>
    </TransitioningContentControl>

    <Panel IsVisible="{Binding Dialog, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Border Background="#8C120F24" PointerPressed="OnBackdropPressed" />
      <TransitioningContentControl Content="{Binding Dialog}"
                                   MaxWidth="440"
                                   Margin="20"
                                   VerticalAlignment="Center">
        <TransitioningContentControl.PageTransition>
          <CrossFade Duration="0:0:0.14" />
        </TransitioningContentControl.PageTransition>
      </TransitioningContentControl>
    </Panel>

    <Panel IsVisible="{Binding IsDropping}" IsHitTestVisible="False">
      <Border Background="#66120F24" />
      <c:PixelFrame Classes="card pop" Fill="{DynamicResource AccentSoftBrush}" Padding="34,26"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="16" HorizontalAlignment="Center">
          <Grid ColumnDefinitions="Auto,Auto,Auto" HorizontalAlignment="Center">
            <c:PixelSprite Classes="twinkle" Sprite="sparkle" Unit="2" VerticalAlignment="Top" />
            <c:PixelSprite Grid.Column="1" Classes="bob" Sprite="world" Unit="6" Margin="12,0" />
            <c:PixelSprite Grid.Column="2" Classes="twinkle" Sprite="sparkle" Unit="3" VerticalAlignment="Bottom" />
          </Grid>
          <c:PixelSprite Sprite="download" Unit="3" HorizontalAlignment="Center" Classes="bob" />
          <TextBlock Classes="h2" Text="{app:Tr dropWorld}" HorizontalAlignment="Center" />
        </StackPanel>
      </c:PixelFrame>
    </Panel>

    <c:PixelFrame Classes="toast"
                  IsVisible="{Binding Toast, Converter={x:Static ObjectConverters.IsNotNull}}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Bottom"
                  Margin="0,0,0,40">
      <TextBlock Text="{Binding Toast}" FontWeight="SemiBold" />
    </c:PixelFrame>
  </Panel>
</UserControl>
