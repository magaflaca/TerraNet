<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TerraNet.App.ViewModels"
             xmlns:v="using:TerraNet.App.Views"
             xmlns:c="using:TerraNet.App.Controls"
             xmlns:app="using:TerraNet.App"
             x:Class="TerraNet.App.Views.WorldEditorView"
             x:DataType="vm:WorldEditorViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="ChoiceTemplate" x:DataType="vm:Choice">
      <StackPanel Spacing="8">
        <c:PixelSprite Sprite="{Binding Sprite}" Unit="{Binding Unit}" Height="56" />
        <TextBlock Text="{Binding Label}" FontSize="14" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <c:PixelFrame Classes="sheet tall">
  <Grid RowDefinitions="Auto,*,Auto">
    <v:PageHeader Title="{app:Tr newWorld}" />

    <ScrollViewer Grid.Row="1">
      <StackPanel MaxWidth="560" Margin="16,8,16,16" Spacing="20">
        <StackPanel>
          <TextBlock Classes="label" Text="{app:Tr name}" />
          <Grid ColumnDefinitions="*,Auto">
            <c:PixelFrame Classes="field">
              <TextBox Text="{Binding Name}" MaxLength="27" />
            </c:PixelFrame>
            <Button Grid.Column="1" Classes="soft icon" Margin="10,0,0,0" Command="{Binding RandomizeCommand}">
              <c:PixelSprite Sprite="diceIcon" Unit="2" />
            </Button>
          </Grid>
        </StackPanel>

        <StackPanel>
          <TextBlock Classes="label" Text="{app:Tr size}" />
          <ListBox Theme="{StaticResource ChoiceList}"
                   ItemsSource="{Binding Sizes}"
                   SelectedItem="{Binding Size}"
                   ItemTemplate="{StaticResource ChoiceTemplate}" />
          <Grid ColumnDefinitions="Auto,*" Margin="0,14,0,0"
                IsVisible="{Binding ShowHeavyHint}" Classes.pop="{Binding ShowHeavyHint}">
            <StackPanel VerticalAlignment="Bottom" Margin="0,0,6,0">
              <c:PixelSprite Classes="twinkle" Sprite="sparkle" Unit="2" HorizontalAlignment="Right" />
              <c:PixelSprite Classes="bob" Sprite="slime" Unit="3" />
            </StackPanel>
            <c:PixelFrame Grid.Column="1" Classes="card" Fill="{DynamicResource AccentSoftBrush}" Padding="14,12">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <c:PixelSprite Sprite="heart" Unit="2" VerticalAlignment="Center" />
                  <TextBlock Classes="h2" Text="{app:Tr heavyTitle}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding HeavyHint}" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource InkBrush}" />
                <StackPanel Spacing="2">
                  <Button Classes="ghost" HorizontalAlignment="Left" Padding="2,4" Command="{Binding ImportInsteadCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <c:PixelSprite Sprite="download" Unit="1" Tint="{DynamicResource InkBrush}" />
                      <TextBlock Text="{app:Tr heavyImport}" FontSize="14" TextDecorations="Underline" />
                    </StackPanel>
                  </Button>
                  <Button Classes="ghost" HorizontalAlignment="Left" Padding="2,4" Command="{Binding BridgeInsteadCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <c:PixelSprite Sprite="gamepad" Unit="1" Tint="{DynamicResource InkBrush}" />
                      <TextBlock Text="{app:Tr heavyBridge}" FontSize="14" TextDecorations="Underline" />
                    </StackPanel>
                  </Button>
                </StackPanel>
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
                  <Button Classes="ghost" Padding="4,8" Command="{Binding KeepSizeCommand}">
                    <TextBlock Text="{app:Tr keepSize}" Foreground="{DynamicResource InkMutedBrush}" />
                  </Button>
                  <Button Grid.Column="2" Classes="primary" Padding="12,8" Command="{Binding UseSmallCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <c:PixelSprite Sprite="sparkle" Unit="1" />
                      <TextBlock Text="{app:Tr useSmall}" Foreground="{DynamicResource OnPrimaryBrush}" />
                    </StackPanel>
                  </Button>
                </Grid>
              </StackPanel>
            </c:PixelFrame>
          </Grid>
        </StackPanel>

        <StackPanel>
          <TextBlock Classes="label" Text="{app:Tr difficulty}" />
          <ListBox Theme="{StaticResource ChoiceList}"
                   ItemsSource="{Binding Difficulties}"
                   SelectedItem="{Binding Difficulty}"
                   ItemTemplate="{StaticResource ChoiceTemplate}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
          </ListBox>
        </StackPanel>

        <StackPanel>
          <TextBlock Classes="label" Text="{app:Tr evil}" />
          <ListBox Theme="{StaticResource ChoiceList}"
                   ItemsSource="{Binding Evils}"
                   SelectedItem="{Binding Evil}"
                   ItemTemplate="{StaticResource ChoiceTemplate}" />
        </StackPanel>

        <StackPanel>
          <TextBlock Classes="label" Text="{app:Tr seed}" />
          <c:PixelFrame Classes="field">
            <TextBox Text="{Binding Seed}" PlaceholderText="{app:Tr optional}" />
          </c:PixelFrame>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2">
      <Button Classes="primary"
              MaxWidth="560"
              Margin="16,8,16,16"
              HorizontalAlignment="Stretch"
              Command="{Binding CreateCommand}">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <c:PixelSprite Sprite="sparkle" Unit="2" />
          <TextBlock Text="{app:Tr create}" Foreground="{DynamicResource OnPrimaryBrush}" FontSize="18" />
        </StackPanel>
      </Button>
    </Border>
  </Grid>
  </c:PixelFrame>
</UserControl>
