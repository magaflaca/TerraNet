<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TerraNet.App.ViewModels"
             xmlns:v="using:TerraNet.App.Views"
             xmlns:c="using:TerraNet.App.Controls"
             xmlns:app="using:TerraNet.App"
             x:Class="TerraNet.App.Views.ServerSettingsView"
             x:DataType="vm:ServerSettingsViewModel">
  <UserControl.Styles>
    <Style Selector="Grid.row">
      <Setter Property="MinHeight" Value="44" />
    </Style>
    <Style Selector="Grid.row TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <c:PixelFrame Classes="sheet tall">
    <Grid RowDefinitions="Auto,*">
      <v:PageHeader Title="{app:Tr server}" />

      <ScrollViewer Grid.Row="1">
        <StackPanel MaxWidth="560" Margin="16,8,16,28" Spacing="18">
          <c:PixelFrame Classes="card" Fill="{DynamicResource AccentSoftBrush}" Padding="14,12">
            <Grid ColumnDefinitions="Auto,*">
              <c:PixelSprite Classes="bob" Sprite="slime" Unit="2" VerticalAlignment="Center" Margin="0,0,12,0" />
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{app:Tr serverHint}" TextWrapping="Wrap" FontSize="15" />
                <TextBlock Classes="muted" Text="{app:Tr appliesNextTime}" TextWrapping="Wrap" FontSize="13" />
              </StackPanel>
            </Grid>
          </c:PixelFrame>

          <c:PixelFrame Classes="card">
            <StackPanel Spacing="14">
              <Grid Classes="row" ColumnDefinitions="Auto,*,Auto">
                <c:PixelSprite Sprite="person" Unit="2" Margin="0,0,12,0" />
                <TextBlock Grid.Column="1" Text="{app:Tr maxPlayers}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                  <Button Classes="soft icon" Command="{Binding FewerPlayersCommand}">
                    <c:PixelSprite Sprite="minus" Unit="1" />
                  </Button>
                  <TextBlock Text="{Binding MaxPlayers}" FontSize="20" FontWeight="Bold" MinWidth="28" TextAlignment="Center" />
                  <Button Classes="soft icon" Command="{Binding MorePlayersCommand}">
                    <c:PixelSprite Sprite="plus" Unit="1" />
                  </Button>
                </StackPanel>
              </Grid>
              <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                  <c:PixelSprite Sprite="lock" Unit="2" />
                  <TextBlock Text="{app:Tr password}" VerticalAlignment="Center" />
                </StackPanel>
                <c:PixelFrame Classes="field">
                  <TextBox Text="{Binding Password}" PlaceholderText="{app:Tr none}" MaxLength="40" />
                </c:PixelFrame>
              </StackPanel>
            </StackPanel>
          </c:PixelFrame>

          <StackPanel>
            <TextBlock Classes="label" Text="{app:Tr pvp}" />
            <ListBox Theme="{StaticResource ChoiceList}" ItemsSource="{Binding PvpModes}" SelectedItem="{Binding Pvp}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:Choice">
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <c:PixelSprite Sprite="{Binding Sprite}" Unit="2" />
                    <TextBlock Text="{Binding Label}" FontSize="14" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>

          <c:PixelFrame Classes="card">
            <StackPanel Spacing="10">
              <Grid Classes="row" ColumnDefinitions="Auto,*,Auto">
                <c:PixelSprite Sprite="house" Unit="1" Margin="0,0,12,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{app:Tr spawnProtection}" />
                <c:PixelSwitch Grid.Column="2" IsChecked="{Binding SpawnProtection}" />
              </Grid>
              <Grid Classes="row" ColumnDefinitions="*,Auto" IsVisible="{Binding SpawnProtection}" Margin="36,0,0,0">
                <TextBlock Classes="muted" Text="{app:Tr radius}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                  <Button Classes="soft icon" Command="{Binding NarrowerSpawnCommand}">
                    <c:PixelSprite Sprite="minus" Unit="1" />
                  </Button>
                  <TextBlock Text="{Binding SpawnRadius}" FontSize="18" FontWeight="Bold" MinWidth="28" TextAlignment="Center" />
                  <Button Classes="soft icon" Command="{Binding WiderSpawnCommand}">
                    <c:PixelSprite Sprite="plus" Unit="1" />
                  </Button>
                </StackPanel>
              </Grid>
              <Grid Classes="row" ColumnDefinitions="Auto,*,Auto">
                <c:PixelSprite Sprite="crown" Unit="2" Margin="0,0,12,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{app:Tr antiCheat}" />
                  <TextBlock Classes="muted" Text="{app:Tr antiCheatHint}" FontSize="13" TextWrapping="Wrap" />
                </StackPanel>
                <c:PixelSwitch Grid.Column="2" IsChecked="{Binding AntiCheat}" />
              </Grid>
              <Grid Classes="row" ColumnDefinitions="Auto,*,Auto">
                <c:PixelSprite Sprite="console" Unit="2" Margin="0,0,12,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{app:Tr playerCommands}" />
                  <TextBlock Classes="muted" Text="{app:Tr playerCommandsHint}" FontSize="13" TextWrapping="Wrap" />
                </StackPanel>
                <c:PixelSwitch Grid.Column="2" IsChecked="{Binding PlayerCommands}" />
              </Grid>
            </StackPanel>
          </c:PixelFrame>

          <Button Classes="tile" Command="{Binding OpenAllOptionsCommand}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <c:PixelSprite Sprite="sliders" Unit="3" VerticalAlignment="Center" Margin="0,0,14,0" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Classes="h2" Text="{app:Tr allOptions}" />
                <TextBlock Classes="muted" Text="{app:Tr allOptionsHint}" TextWrapping="Wrap" FontSize="13" />
              </StackPanel>
              <c:PixelSprite Grid.Column="2" Sprite="chevron" Unit="2" VerticalAlignment="Center" />
            </Grid>
          </Button>

          <c:PixelFrame Classes="card">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <c:PixelSprite Sprite="sparkle" Unit="2" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="{app:Tr welcome}" VerticalAlignment="Center" />
                <Button Grid.Column="2" Classes="ghost" Command="{Binding ResetWelcomeCommand}">
                  <c:PixelSprite Sprite="diceIcon" Unit="2" Tint="{DynamicResource InkMutedBrush}" />
                </Button>
              </Grid>
              <c:PixelFrame Classes="field">
                <TextBox Text="{Binding Welcome}" TextWrapping="Wrap" AcceptsReturn="False" MaxLength="200" FontSize="15" />
              </c:PixelFrame>
              <c:PixelFrame Classes="chip" Padding="10,8" Fill="#2A2447">
                <c:ChatPreview Markup="{Binding Welcome}" TextWrapping="Wrap" FontSize="15" Foreground="#FFFFFF" />
              </c:PixelFrame>
            </StackPanel>
          </c:PixelFrame>

          <c:PixelFrame Classes="card">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <c:PixelSprite Sprite="plug" Unit="2" Margin="0,0,10,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{app:Tr plugins}" FontWeight="Bold" />
                  <TextBlock Classes="muted" Text="{app:Tr pluginsHint}" FontSize="13" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="2" Classes="primary icon" Command="{Binding AddPluginCommand}">
                  <c:PixelSprite Sprite="plus" Unit="2" />
                </Button>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsEmpty}" Margin="0,4">
                <c:PixelSprite Classes="twinkle" Sprite="sparkle" Unit="2" />
                <TextBlock Classes="muted" Text="{app:Tr noPlugins}" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Plugins}" IsVisible="{Binding HasPlugins}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PluginItemViewModel">
                    <c:PixelFrame Classes="chip" Margin="0,0,0,8" Padding="10,8">
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <c:PixelSprite Sprite="plug" Unit="2" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="muted" Text="{Binding SizeLabel}" FontSize="12" />
                        </StackPanel>
                        <Button Grid.Column="2" Classes="ghost" Margin="6,0"
                                Command="{Binding $parent[ItemsControl].((vm:ServerSettingsViewModel)DataContext).DeletePluginCommand}"
                                CommandParameter="{Binding}">
                          <c:PixelSprite Sprite="trash" Unit="2" Tint="{DynamicResource InkMutedBrush}" />
                        </Button>
                        <c:PixelSwitch Grid.Column="3" IsChecked="{Binding Enabled}" VerticalAlignment="Center" />
                      </Grid>
                    </c:PixelFrame>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </c:PixelFrame>

          <c:PixelFrame Classes="card">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="Auto,*">
                <c:PixelSprite Sprite="chest" Unit="2" Margin="0,0,12,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{app:Tr exportServer}" FontWeight="Bold" />
                  <TextBlock Classes="muted" Text="{app:Tr exportServerHint}" FontSize="13" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
              <Grid Classes="row" ColumnDefinitions="Auto,*,Auto">
                <c:PixelSprite Sprite="world" Unit="1" Margin="0,0,12,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{app:Tr includeWorlds}" />
                <c:PixelSwitch Grid.Column="2" IsChecked="{Binding IncludeWorlds}" />
              </Grid>
              <Button Classes="primary" HorizontalAlignment="Stretch" Command="{Binding ExportServerCommand}" IsEnabled="{Binding !Exporting}">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                  <c:PixelSprite Sprite="export" Unit="2" />
                  <TextBlock Text="{app:Tr exportServer}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </c:PixelFrame>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </c:PixelFrame>
</UserControl>
